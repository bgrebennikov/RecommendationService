package com.github.bgrebennikov.recommendationservice.data.rule;

import com.github.bgrebennikov.recommendationservice.data.types.ProductType;
import com.github.bgrebennikov.recommendationservice.model.RuleQuery;
import com.github.bgrebennikov.recommendationservice.repository.RecommendationRepository;
import org.springframework.stereotype.Component;

import java.math.BigDecimal;
import java.util.UUID;

import static com.github.bgrebennikov.recommendationservice.enums.QueryType.TRANSACTION_COUNT_COMPARE;

@Component
public class DynamicRuleEvaluator {

    private final RecommendationRepository recommendationRepository;

    public DynamicRuleEvaluator(RecommendationRepository recommendationRepository) {
        this.recommendationRepository = recommendationRepository;
    }

    public boolean evaluate(RuleQuery query, UUID userId) {
        boolean result = executeCheck(query, userId);
        return Boolean.TRUE.equals(query.getNegate()) ? !result : result;
    }

    private boolean executeCheck(RuleQuery query, UUID userId) {
        if (query.getArguments() == null || query.getArguments().isEmpty()) {
            return false;
        }

        // В switch по Enum НЕ НУЖНЫ статические импорты констант
        return switch (query.getQueryType()) {
            case USER_OF, ACTIVE_USER_OF -> {
                ProductType pType = ProductType.valueOf(query.getArguments().get(0).toUpperCase());
                yield recommendationRepository.hasProductType(userId, pType);
            }

            case TRANSACTION_SUM_COMPARE -> {
                ProductType pType = ProductType.valueOf(query.getArguments().get(0).toUpperCase());
                String transactionType = query.getArguments().get(1).toUpperCase();
                String operator = query.getArguments().get(2);
                BigDecimal threshold = new BigDecimal(query.getArguments().get(3));

                BigDecimal actualSum = "DEPOSIT".equals(transactionType)
                        ? recommendationRepository.sumOfDepositsByType(userId, pType)
                        : recommendationRepository.sumOfWithdrawalsByType(userId, pType);

                yield compareBigDecimal(actualSum, threshold, operator);
            }

            case TRANSACTION_COUNT_COMPARE -> false;

            default -> false;
        };
    }

    private boolean compareBigDecimal(BigDecimal actual, BigDecimal threshold, String operator) {
        if (actual == null) actual = BigDecimal.ZERO;
        int comparison = actual.compareTo(threshold);
        return switch (operator) {
            case ">" -> comparison > 0;
            case "<" -> comparison < 0;
            case ">=" -> comparison >= 0;
            case "<=" -> comparison <= 0;
            case "==" -> comparison == 0;
            default -> false;
        };
    }
}